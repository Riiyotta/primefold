      "about": {
        "type": "object",
        "required": true,
        "fields": {
          "heading": {
            "type": "text",
            "required": true,
            "maxWords": 3,
            "maxWordsBasis": "'About <Client>'"
          },
          "logo": {
            "type": "asset",
            "required": true,
            "roles": [
              "customer.logo"
            ]
          },
          "image": {
            "type": "asset",
            "required": true,
            "roles": [
              "customer.imagery"
            ]
          },
          "description": {
            "type": "text",
            "required": true,
            "maxWords": 26,
            "maxWordsBasis": "longest real client description",
            "placeholderOnly": true
          },
          "website": {
            "type": "link",
            "required": false,
            "labelMaxWords": 2,
            "maxWordsBasis": "longest real label: 2 words"
          },
          "info": {
            "type": "list",
            "required": true,
            "minItems": 3,
            "maxItems": 4,
            "item": {
              "type": "object",
              "required": true,
              "fields": {
                "label": {
                  "type": "text",
                  "required": true,
                  "maxWords": 3,
                  "maxWordsBasis": "Employees / Clients / Industry / Products in use"
                },
                "values": {
                  "type": "list",
                  "required": true,
                  "minItems": 1,
                  "maxItems": 4,
                  "item": {
                    "type": "text",
                    "required": true,
                    "maxWords": 6,
                    "maxWordsBasis": "real values up to 5 words"
                  }
                }
              }
            }
          }
        }
      }
