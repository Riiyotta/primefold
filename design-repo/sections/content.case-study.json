            "authorRole": {
              "type": "text",
              "required": false,
              "maxWords": 6,
              "maxWordsBasis": "e.g. 'Intelligence Analyst, NAS Invest' = 5",
              "placeholderOnly": true
            },
            "cards": {
              "type": "list",
              "required": false,
              "minItems": 3,
              "maxItems": 3,
              "item": {
                "type": "object",
                "required": true,
                "fields": {
                  "title": {
                    "type": "text",
                    "required": true,
                    "maxWords": 8,
                    "maxWordsBasis": "real numbered-card titles up to 5 words"
