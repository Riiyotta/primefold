        "required": true,
        "maxWords": 5,
        "maxWordsBasis": "longest real case-study title"
      },
      "breadcrumb": {
        "type": "text",
        "required": true,
        "maxWords": 1,
        "maxWordsBasis": "longest real instance: 1 words",
        "placeholderOnly": true
      },
      "subtitle": {
        "type": "text",
        "required": true,
        "maxWords": 9,
        "maxWordsBasis": "longest real subtitle",
        "placeholderOnly": true
      },
      "pills": {
        "type": "list",
        "required": true,
        "minItems": 1,
        "maxItems": 8,
        "item": {
          "type": "object",
          "required": true,
          "fields": {
            "label": {
              "type": "text",
              "required": true,
              "maxWords": 4,
              "maxWordsBasis": "longest real pill label"
            },
            "badge": {
              "type": "enum",
              "required": true,
              "values": [
                "none",
                "xi",
                "ri"
              ]
            }
          }
        },
        "countBasis": "real studies have 4-7 pills"
      },
      "banner": {
        "type": "asset",
        "required": true,
        "roles": [
          "customer.imagery"
        ]
      },
      "stats": {
        "type": "list",
        "required": true,
        "minItems": 3,
        "maxItems": 3,
        "item": {
          "type": "object",
          "required": true,
          "fields": {
            "value": {
              "type": "text",
              "required": true,
              "maxWords": 3,
              "maxWordsBasis": "real values like '0 → 150' = 3 tokens",
              "placeholderOnly": true
            },
            "label": {
              "type": "text",
              "required": true,
              "maxWords": 16,
              "maxWordsBasis": "longest real stat label",
              "placeholderOnly": true
            },
            "color": {
              "type": "enum",
              "required": true,
              "values": [
                "teal",
                "green",
                "orange"
              ]
            }
          }
        },
        "countBasis": "three stats per study"
      },
      "blocks": {
        "type": "list",
        "required": true,
        "minItems": 1,
        "maxItems": 35,
        "item": {
          "type": "object",
          "required": true,
          "fields": {
            "type": {
              "type": "enum",
              "required": true,
              "values": [
                "h6",
                "h3",
                "p",
                "spacer",
                "video",
                "quoteCard",
                "numberedCards"
              ]
            },
            "text": {
              "type": "text",
              "required": false,
              "maxWords": 109,
              "maxWordsBasis": "longest real paragraph words in cms-data",
              "placeholderOnly": true
            },
            "author": {
              "type": "text",
              "required": false,
              "maxWords": 3,
              "maxWordsBasis": "real author names are 2 words",
              "placeholderOnly": true
