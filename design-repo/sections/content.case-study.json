                  "body": {
                    "type": "text",
                    "required": true,
                    "maxWords": 60,
                    "maxWordsBasis": "real numbered-card bodyWords up to 60"
                  }
                }
              }
            }
          }
        },
        "countBasis": "real studies have up to 23 blocks; +12 headroom is a design choice"
