  "tags": [
    "case-study",
    "customer-story",
    "stats",
    "cms"
  ],
  "status": "mounted",
  "implementedBy": [
    "src/pages/CaseStudy.jsx",
    "src/pages/cms/RichText.jsx",
    "src/pages/cms/shared.jsx",
    "src/pages/cms/cms.css"
  ],
  "evidence": {
    "level": "measured",
    "unmeasured": [
      "tablet numbered-card grid is a Framer bug; spec recommends repeat(3,1fr) (not the measured value)"
    ]
