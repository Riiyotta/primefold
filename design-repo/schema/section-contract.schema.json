{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "primefold-section-contract",
  "title": "Primefold section contract",
  "description": "Closed schema for sections/*.json (validated by extraction/verify_all.py). source = provenance (what DOM/component it is, traceable to file:lines); semantic = taxonomy the AI sees (semantic.id == id; source.id != id). retrievalEligible false requires a 30+ character retrievalReason.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "category",
    "semantic",
    "source",
    "purpose",
    "tags",
    "status",
    "implementedBy",
    "evidence",
    "allowedTemplates",
    "variants",
    "constraints",
    "content",
    "motion",
    "responsive",
    "notes",
    "measuredFrom",
    "retrievalEligible",
    "rules",
    "assetRoles",
    "generatedAssetRoles",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(shell|hero|features|proof|conversion|content)\\.[a-z0-9-]+$"
    },
    "kind": {
      "const": "section"
    },
    "category": {
      "enum": [
        "SHELL",
        "HERO",
        "FEATURES",
        "PROOF",
        "CONVERSION",
        "CONTENT"
      ]
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "enum": [
            "SHELL",
            "HERO",
            "FEATURES",
            "PROOF",
            "CONVERSION",
            "CONTENT"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tag",
        "file",
        "lines"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^src:"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^(src|specs)/"
        },
        "lines": {
          "type": "string",
          "pattern": "^\\d+-\\d+$"
        }
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 20
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "mounted",
        "spec-only-source-in-progress"
      ]
    },
    "implementedBy": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "unmeasured"
      ],
      "properties": {
        "level": {
          "enum": [
            "measured",
            "inferred"
          ]
        },
        "unmeasured": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "allowedTemplates": {
      "oneOf": [
        {
          "const": "any"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^template\\."
          }
        }
      ]
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onePerPage": {
          "type": "boolean"
        },
        "homeRouteOnly": {
          "type": "boolean"
        },
        "mustFollowNav": {
          "type": "boolean"
        },
        "mustBeLast": {
          "type": "boolean"
        },
        "mustBeFirst": {
          "type": "boolean"
        },
        "mustPrecedeFooter": {
          "type": "boolean"
        },
        "maxPerPage": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields",
        "additionalProperties"
      ],
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/field"
          }
        },
        "additionalProperties": {
          "const": false
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "reducedMotionHandledInSource",
        "reducedMotionSource"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pattern",
              "trigger",
              "reducedMotionFallback",
              "note",
              "measuredFrom"
            ],
            "properties": {
              "pattern": {
                "type": "string"
              },
              "trigger": {
                "type": "string"
              },
              "reducedMotionFallback": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "measuredFrom": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[\\w./@-]+:\\d+(-\\d+)?$"
                }
              }
            }
          }
        },
        "reducedMotionHandledInSource": {
          "enum": [
            "yes",
            "partial",
            "no",
            "unknown"
          ]
        },
        "reducedMotionSource": {
          "type": "string"
        }
      }
    },
    "responsive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desktop",
        "tablet",
        "phone"
      ],
      "properties": {
        "desktop": {
          "type": "string"
        },
        "tablet": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "measuredFrom": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[\\w./@-]+:\\d+(-\\d+)?$"
      }
    },
    "retrievalEligible": {
      "type": "boolean"
    },
    "retrievalReason": {
      "type": "string",
      "minLength": 30
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "variant": {
                "type": "string"
              },
              "variantNot": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "equals": {}
            }
          },
          "require": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbid": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "countField": {
            "type": "string"
          },
          "countEquals": {
            "type": "integer"
          }
        }
      }
    },
    "assetRoles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/assetRole"
      }
    },
    "generatedAssetRoles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/assetRole"
      }
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "retrievalEligible": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "retrievalReason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "retrievalEligible": {
            "const": true
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "retrievalReason"
          ]
        }
      }
    }
  ],
  "definitions": {
    "assetRole": {
      "enum": [
        "brand.logo-mark",
        "brand.wordmark-ghost",
        "brand.product-badge",
        "brand.site-icons",
        "ui.icon-mask",
        "ui.illustration-svg",
        "fx.shader-fallback",
        "hero.backdrop-photo",
        "photo.scene-card",
        "product.illustration-still",
        "customer.logo",
        "customer.imagery",
        "person.team-photo",
        "person.author-avatar",
        "cms.post-image",
        "motion.lottie",
        "embed.video-facade",
        "brand.placeholder-mark",
        "brand.user-supplied-mark",
        "asset.user-supplied",
        "generated.illustration",
        "placeholder.screenshot",
        "fictional.person-avatar",
        "placeholder.company-logo"
      ]
    },
    "field": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "text",
            "target",
            "link",
            "asset",
            "list",
            "object",
            "enum",
            "bool",
            "form"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "type",
              "required",
              "maxWords",
              "maxWordsBasis"
            ],
            "properties": {
              "type": {},
              "required": {
                "type": "boolean"
              },
              "maxWords": {
                "type": "integer",
                "minimum": 1
              },
              "maxWordsBasis": {
                "type": "string",
                "minLength": 1
              },
              "placeholderOnly": {
                "const": true
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "link"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "type",
              "required",
              "labelMaxWords",
              "maxWordsBasis"
            ],
            "properties": {
              "type": {},
              "required": {
                "type": "boolean"
              },
              "labelMaxWords": {
                "type": "integer",
                "minimum": 1
              },
              "maxWordsBasis": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "asset"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "type",
              "required",
              "roles"
            ],
            "properties": {
              "type": {},
              "required": {
                "type": "boolean"
              },
              "roles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/definitions/assetRole"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "list"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "type",
              "required",
              "minItems",
              "maxItems",
              "item"
            ],
            "properties": {
              "type": {},
              "required": {
                "type": "boolean"
              },
              "minItems": {
                "type": "integer",
                "minimum": 0
              },
              "maxItems": {
                "type": "integer",
                "minimum": 1
              },
              "countBasis": {
                "type": "string"
              },
              "item": {
                "$ref": "#/definitions/field"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "object"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "type",
              "required",
              "fields"
            ],
            "properties": {
              "type": {},
              "required": {
                "type": "boolean"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/definitions/field"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "type",
              "required",
              "values"
            ],
            "properties": {
              "type": {},
              "required": {
                "type": "boolean"
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "primefoldBadgeValues": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "bool",
                  "target"
                ]
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "type",
              "required"
            ],
            "properties": {
              "type": {},
              "required": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "form"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "type",
              "required",
              "endpointRole"
            ],
            "properties": {
              "type": {},
              "required": {
                "type": "boolean"
              },
              "endpointRole": {
                "enum": [
                  "endpoint.contact-form",
                  "endpoint.newsletter-form"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
